# ─────────────────────────────────────────────────────────────────
# Omni Virtual Solutions — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to git.

# ── Server ────────────────────────────────────────────────────────
PORT=3000

# ── Database — Local SQLite (default, no setup needed) ────────────
# Leave TURSO_DATABASE_URL empty to use the local SQLite file.
# The app auto-detects which mode to use.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── When you are ready to connect to Turso Cloud ──────────────────
# Uncomment and fill these in. No other code changes needed.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# ── JWT Secret ────────────────────────────────────────────────────
# Change this to a long random string in production!
JWT_SECRET=omni-cms-local-dev-secret-change-before-deploy

# ── Email (SMTP) — Managed via Admin > Email Settings ─────────────
# All SMTP credentials are stored securely in the database.
# Admins configure email from the dashboard — no code changes needed.
# Supported free providers:
#   Gmail:     smtp.gmail.com, port 587 (requires App Password)
#   Outlook:   smtp-mail.outlook.com, port 587
#   Brevo:     smtp-relay.brevo.com, port 587 (300 emails/day free)
#   Mailjet:   in-v3.mailjet.com, port 587 (200 emails/day free)

